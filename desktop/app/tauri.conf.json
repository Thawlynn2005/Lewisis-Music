{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lewisis Music",
  "mainBinaryName": "lewisis-music",
  "identifier": "com.lewisis.music",
  "build": {
    "frontendDist": "../../static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lewisis' Music",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: media: http://media.localhost",
        "font-src": "'self' data:",
        "media-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi", "app", "dmg"],
    "category": "Music",
    "shortDescription": "A local music player",
    "longDescription": "Lewisis' Music plays the songs on your computer, with lyrics, playlists, slowed and nightcore speeds, reverbs and AI vocal / instrumental separation.",
    "copyright": "Copyright Thaw Zin Lynn. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/*"],
    "linux": {
      "deb": {
        "depends": ["libasound2 | libasound2t64"],
        "section": "sound"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
